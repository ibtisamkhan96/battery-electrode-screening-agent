# Materials Project. Free key: https://next-gen.materialsproject.org/api
MP_API_KEY=

# Choose one LLM provider and set its key. LLM_PROVIDER selects which.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith tracing (optional but recommended). Free key: https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=battery-electrode-screening-agent

# Optional: locks the API behind a bearer token. Leave blank for an open local demo.
API_AUTH_TOKEN=

# UI -> API wiring
API_BASE_URL=http://localhost:8000

# CORS, comma-separated origins, "*" for a local demo
CORS_ORIGINS=*
